{
  "name": "snake-game",
  "version": "2.0.0",
  "private": true,
  "description": "A premium arcade Snake game built with React, TypeScript, Framer Motion, and HTML5 Canvas.",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3002",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "snake",
    "game",
    "canvas",
    "react",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
